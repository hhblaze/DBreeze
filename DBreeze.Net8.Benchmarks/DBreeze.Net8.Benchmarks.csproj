<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.20" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DBreeze.ReleaseAudit.Protocol\DBreeze.ReleaseAudit.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(DBreezeAssemblyReference)' == ''">
    <ProjectReference Include="..\DBreeze.Net8\DBreeze.Net8.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(DBreezeAssemblyReference)' != ''">
    <Reference Include="DBreeze" HintPath="$(DBreezeAssemblyReference)" Private="true" />
  </ItemGroup>

</Project>
