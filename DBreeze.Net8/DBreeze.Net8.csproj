  </ItemGroup>

  <Target Name="ValidateModernSourceIsolation" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_ForbiddenModernLegacyLink Include="@(Compile)"
        Condition="'%(Compile.Link)' == 'LianaTrie\LianaTrie.cs' Or
                   '%(Compile.Link)' == 'LianaTrie\LTrieRootNode.cs' Or
                   '%(Compile.Link)' == 'Storage\StorageLayer.cs'" />
    </ItemGroup>
    <Error
      Condition="$([System.Text.RegularExpressions.Regex]::IsMatch(';$(DBreezeCompatibilityConstants);', ';NET8(_0(_OR_GREATER)?|_OR_GREATER);'))"
      Text="DBreezeCompatibilityConstants must not contain an exact NET8 target-framework symbol." />
    <Error
      Condition="'@(_ForbiddenModernLegacyLink)' != ''"
      Text="Modern-specific sources must be owned by DBreeze.Net8, not linked from the legacy DBreeze project: @(_ForbiddenModernLegacyLink, ', ')." />
  </Target>

</Project>
