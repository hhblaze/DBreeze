<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>DBreeze</AssemblyName>
    <RootNamespace>DBreeze</RootNamespace>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\Keys\jahdrosigning.snk</AssemblyOriginatorKeyFile>
    <Version>1.139.2026.0817</Version>
    <FileVersion>1.139.2026.0817</FileVersion>
    <AssemblyVersion>1.139.2026.0817</AssemblyVersion>
    <Copyright>Copyright © dbreeze.tiesky.com / Alex Solovyov (hhblaze@gmail.com) / Ivars Sudmalis 2012</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DocumentationFile>bin\Release\net5.0\DBreeze.xml</DocumentationFile>
    <DBreezeCompatibilityConstants>NET40;NET50;NET6FUNC;NET6_0;NETCOREAPP;NETCOREAPP1_0;NETCOREAPP2_0</DBreezeCompatibilityConstants>
    <DefineConstants>$(DefineConstants);$(DBreezeCompatibilityConstants)</DefineConstants>
    <OutputPath>bin\Release\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DBreezeCompatibilityConstants>NET40;NET6FUNC;NETCOREAPP1_0;NETCOREAPP2_0</DBreezeCompatibilityConstants>
    <DefineConstants>$(DefineConstants);$(DBreezeCompatibilityConstants)</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DBreezeDurabilityTestHooks)' == 'true'">
