<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup Condition="'$(DBreezeAssemblyReference)' == ''">
    <ProjectReference Include="..\DBreeze.Net8\DBreeze.Net8.csproj"
                      AdditionalProperties="DBreezeDurabilityTestHooks=true" />
  </ItemGroup>

  <ItemGroup Condition="'$(DBreezeAssemblyReference)' != ''">
    <Reference Include="DBreeze" HintPath="$(DBreezeAssemblyReference)" Private="true" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\DBreeze.Storage.Contracts\TransactionLifetimeContracts.cs" Link="TransactionLifetimeContracts.cs" />
    <Compile Include="..\DBreeze.Net8.Benchmarks\CacheOrderProbe.cs" Link="CacheOrderProbe.cs" />
  </ItemGroup>

</Project>
